{
  "name": "desktop-for-web3",
  "version": "0.1.0",
  "description": "iOS-style new tab page for Web3 enthusiasts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/run-automated-test.cjs",
    "test:e2e:quick": "node tests/run-automated-test.cjs --quick",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "worker:dev": "cd worker && npm run dev",
    "worker:deploy": "cd worker && npm run deploy",
    "worker:deploy:staging": "cd worker && npm run deploy:staging",
    "worker:install": "cd worker && npm install"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "d3-geo": "^3.1.1",
    "solid-js": "^1.8.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/chrome": "^0.1.40",
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-solid": "^0.14.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.35.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.8.0",
    "vitest": "^3.2.4"
  }
}
